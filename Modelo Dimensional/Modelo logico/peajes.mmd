        atributo metodo_deteccion
        atributo confianza
        atributo origen
        fecha vigente_desde
        fecha vigente_hasta
    }
    PEAJES__PUENTE_SEGMENTO_PLAZA_DETECCION {
        id id_fila PK
        atributo sk_segmento
        atributo id_plaza
        atributo orden
        medida km_desde_inicio
        atributo metodo_deteccion
        atributo confianza
        fecha vigente_desde
        fecha vigente_hasta
    }
    PEAJES__PUENTE_TRAMO_SEGMENTO {
        id sk_tramo PK,FK
        id sk_segmento FK
        id orden PK
    }
    COMUN__DIM_FECHA {
        id sk_fecha PK "tabla de otro esquema"
    }
    DIM_COMUN__DIM_TRAMO_COMERCIAL {
        id tramo_id PK "tabla de otro esquema"
    }
    VENTAS__FACT_VIAJE_VENTA {
        id nro_viaje PK "tabla de otro esquema"
        id sk_fecha FK
        id cliente_id FK
        id producto_id FK
        id sit_stretch_id FK
        id equipo_id FK
        id rampla_id FK
        id transportista_id FK
        id conductor_id FK
    }
    VISTAS_PEAJES {
        view v_peaje_tramo_detalle
        view v_peaje_viaje
        view v_puente_tramo_plaza
        view v_tarifa_vigente
    }
