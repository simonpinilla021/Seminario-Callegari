        id sk_segmento PK
        atributo desde_clave
        atributo hasta_clave
        id sk_lugar_desde FK
        id sk_lugar_hasta FK
        medida km_ruta
        medida horas_ruta
        atributo estado
        atributo version_ruta
    }
