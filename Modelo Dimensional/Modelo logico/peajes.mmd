    PEAJES__DIM_TRAMO {
        id sk_tramo PK
        id sit_stretch_id FK
        atributo texto_tramo
        id sk_lugar_origen FK
        id sk_lugar_destino FK
        atributo n_puntos
        medida km_erp
        medida km_ruta_calculada
        atributo es_recorrido
        atributo isactive
        atributo estado_deteccion
        fecha vigente_desde
        fecha vigente_hasta
        atributo es_actual
    }
    PEAJES__FACT_VIAJE_PEAJE {
        id sk_viaje PK
        id nro_viaje FK
        atributo nro_hoja_ruta
        id sk_tramo FK
        id sk_fecha_inicio FK
        atributo es_retorno
        medida peaje_referencial
        medida peaje_referencial_maximo
        atributo estado_peaje
    }
    PEAJES__AJUSTE_SEGMENTO_PLAZA {
        atributo desde_clave
        atributo hasta_clave
        atributo id_plaza
        atributo accion
        medida km_desde_inicio
        fecha vigente_desde
        atributo motivo
    }
    PEAJES__DIM_CONDICION_TARIFA {
        id sk_condicion PK
        atributo categoria_vehicular
        atributo horario
        atributo modalidad
        atributo aplica_a_flota
    }
    PEAJES__DIM_DOCUMENTO_TARIFA {
        id sk_documento PK
        atributo url
        atributo documento
        atributo seccion
        atributo anio
        atributo archivo_local
        atributo bytes
        fecha fecha_descarga
    }
    PEAJES__DIM_LUGAR {
        id sk_lugar PK
        atributo clave_lugar
        atributo nombre_erp
        atributo localidad
        atributo sublugar
        atributo region
        medida latitud
        medida longitud
        atributo _precision_
        atributo fuente
        atributo es_base
        atributo es_lugar
    }
    PEAJES__DIM_PLAZA_PEAJE {
        id sk_plaza PK
        atributo id_plaza
        atributo clave_plaza_script
        atributo plaza_id_mop
        atributo nombre_plaza
        atributo codigo_portico
