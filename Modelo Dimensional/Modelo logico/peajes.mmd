        id sk_tramo PK,FK
        id vigente_desde PK
        fecha vigente_hasta
        id orden_segmento PK
        id sk_segmento FK
        id orden_en_segmento PK
        atributo id_plaza
        medida tarifa_base_plaza
        medida tarifa_maxima_plaza
