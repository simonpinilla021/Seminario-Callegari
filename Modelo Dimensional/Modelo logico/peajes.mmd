        atributo horario_base
        atributo modalidad_base
        atributo cobrada
        medida peaje_base
        medida peaje_maximo
        atributo motivo
    }
    PEAJES__FACT_PEAJE_REFERENCIAL_TRAMO {
        id sk_tramo PK,FK
        id vigente_desde PK
        fecha vigente_hasta
        medida peaje_base
        medida peaje_maximo
        atributo cantidad_plazas
        atributo plazas_sin_tarifa
        atributo estado
    }
    PEAJES__FACT_TARIFA_PEAJE {
        id sk_tarifa PK
        id sk_plaza FK
        atributo id_plaza
        id sk_condicion FK
        atributo variante
        fecha vigente_desde
        fecha vigente_hasta
        medida tarifa_clp
        atributo origen_tarifa
        atributo metodo_asignacion
        atributo confianza
        atributo categoria_texto_lamina
        id sk_documento FK
        atributo observacion
    }
    PEAJES__PARAMETRO_PEAJE {
        id parametro PK
        atributo valor
        atributo descripcion
    }
