    COMUN__DIM_FECHA ||--o{ COSTOS__FACT_ABSORCION_VIAJE : "sk_fecha"
    COMUN__DIM_FECHA ||--o{ COSTOS__FACT_CONTABILIDAD_MENSUAL : "sk_fecha_mes"
    COMUN__DIM_FECHA ||--o{ COSTOS__FACT_VIAJE_COSTO_INDIRECTO : "sk_fecha_inicio"
    COSTOS__DIM_CUENTA_CONTABLE ||--o{ COSTOS__FACT_CONTABILIDAD_MENSUAL : "sk_cuenta"
    DIM_COMUN__DIM_EQUIPO ||--o{ COSTOS__FACT_CONTABILIDAD_MENSUAL : "equipo_id"
    DIM_COMUN__DIM_EQUIPO ||--o{ COSTOS__FACT_VIAJE_COSTO_INDIRECTO : "equipo_id"
